# clangd config for Qualia — mirrors the flags in `makefile`.
# Unity build: qualia.cc #includes every other .cc directly, so the individual
# .cc files are not standalone translation units. clangd indexes each file on
# its own, so cross-file "undeclared identifier" noise is expected when viewing
# an included .cc alone — feed it the same flags the real build uses.

CompileFlags:
  Add:
    - -std=c++23
    - -nostdinc++
    - -fno-rtti
    - -fno-exceptions
    - -DDEBUG
    # Match the build's warning suppressions so clangd doesn't flag intentional usage.
    - -Wno-vla-cxx-extension
    - -Wno-c99-designator
    - -Wno-reorder-init-list
    - -Wshift-op-parentheses
  Remove:
    - -std=c++*                    # Drop any conflicting std from a compile_commands.json
    # Linux/release-only flags that clangd can't or shouldn't apply (esp. on macOS).
    - -mcmodel=*
    - -march=*
    - -no-pie

# Suppress unhelpful diagnostics
Diagnostics:
  UnusedIncludes: None          # Don't warn about unused includes (unity build)
  MissingIncludes: None         # Don't warn about missing std library headers
  ClangTidy:
    Remove:
      - modernize-*             # Skip modernize checks
      - readability-identifier-length  # Allow short names like 'i', 'n', 'c'

# Show type information inline (helpful with auto)
InlayHints:
  Enabled: Yes
  ParameterNames: Yes           # Show parameter names in function calls
  DeducedTypes: Yes             # Show deduced types for auto
  Designators: Yes              # Show designators in aggregate initialization

# Control indexing behavior
Index:
  Background: Build             # Index in background, prioritize build files
  StandardLibrary: No           # Don't index standard library
